{
  "name": "sargas-pf2-creature-images",
  "version": "0.3.0",
  "private": true,
  "description": "Foundry VTT v14 PF2e module that applies Demiplane Nexus creature art. Images are fetched locally and never committed.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "crawl": "node scripts/crawl.mjs",
    "download": "node scripts/download.mjs",
    "fetch:pf2e": "node scripts/fetch-pf2e.mjs",
    "match": "node scripts/match.mjs",
    "mapping": "node scripts/mapping.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "check:art": "node scripts/check-no-art.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^8.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  }
}
